    {"id": "st5_story_01", "speaker": "NARRATOR (Jason F, CosyVoice 3 clone, own voice, consented)", "who": "narrator", "text": "Loial led him through the Ways. In the dark, a wind whispered Riley's name.", "file": "assets/audio/voice/st5_story_01.mp3", "engine": "cosyvoice", "duration_s": 5.184, "bytes": 62540, "sha256": "423153e9dde65339c6152b8e2c78dc48513c2564483f9e9f5e2bbe05a87c9752"},
    {"id": "st5_story_02", "speaker": "RILEY", "who": "riley", "text": "The trail runs north. Into the Blight.", "file": "assets/audio/voice/st5_story_02.mp3", "engine": "elevenlabs"},
    {"id": "st5_story_03", "speaker": "LOIAL", "who": "loial", "text": "Nothing grows right here, Riley. Not even the trees.", "file": "assets/audio/voice/st5_story_03.mp3", "engine": "kokoro"},
    {"id": "st5_story_04", "speaker": "NARRATOR (Jason F, CosyVoice 3 clone, own voice, consented)", "who": "narrator", "text": "Past the hills, something old was waiting.", "file": "assets/audio/voice/st5_story_04.mp3", "engine": "cosyvoice", "duration_s": 2.688, "bytes": 32588, "sha256": "13102605ee579dae2f275d6171ca0fc826bab38fdfd1de772e2154060470e3da"},
    {"id": "st5_story_05", "speaker": "RILEY", "who": "riley", "text": "Good. I'm in a mood.", "file": "assets/audio/voice/st5_story_05.mp3", "engine": "elevenlabs"},
    {"id": "st5_clear_01", "speaker": "RILEY", "who": "riley", "text": "She's not here. The Fade went south.", "file": "assets/audio/voice/st5_clear_01.mp3", "engine": "elevenlabs"},
    {"id": "st5_clear_02", "speaker": "LOIAL", "who": "loial", "text": "South is Tarwin's Gap. Every Trolloc in the Blight is going there.", "file": "assets/audio/voice/st5_clear_02.mp3", "engine": "kokoro"},
    {"id": "st5_clear_03", "speaker": "RILEY", "who": "riley", "text": "Then so am I.", "file": "assets/audio/voice/st5_clear_03.mp3", "engine": "elevenlabs"},
    {"id": "riley_st5_stalk_01", "speaker": "RILEY", "who": "riley", "text": "Something's in the grass.", "file": "assets/audio/voice/riley_st5_stalk_01.mp3", "engine": "elevenlabs"},
    {"id": "riley_st5_tree_01", "speaker": "RILEY", "who": "riley", "text": "The trees are moving!", "file": "assets/audio/voice/riley_st5_tree_01.mp3", "engine": "elevenlabs"},
    {"id": "riley_st5_ring_01", "speaker": "RILEY", "who": "riley", "text": "Jump it!", "file": "assets/audio/voice/riley_st5_ring_01.mp3", "engine": "elevenlabs"},
    {"id": "riley_st5_free_01", "speaker": "RILEY", "who": "riley", "text": "Get your hands off me, corpse.", "file": "assets/audio/voice/riley_st5_free_01.mp3", "engine": "elevenlabs"},
    {"id": "riley_st5_greenman_01", "speaker": "RILEY", "who": "riley", "text": "No! Not him!", "file": "assets/audio/voice/riley_st5_greenman_01.mp3", "engine": "elevenlabs"},
    {"id": "riley_st5_victory_01", "speaker": "RILEY", "who": "riley", "text": "Burn, then.", "file": "assets/audio/voice/riley_st5_victory_01.mp3", "engine": "elevenlabs"},
    {"id": "aginor_intro_01", "speaker": "AGINOR", "who": "aginor", "text": "A channeler. Untrained. Delicious.", "file": "assets/audio/voice/aginor_intro_01.mp3", "engine": "elevenlabs"},
    {"id": "aginor_drain_01", "speaker": "AGINOR", "who": "aginor", "text": "Your strength is wasted on you.", "file": "assets/audio/voice/aginor_drain_01.mp3", "engine": "elevenlabs", "loop": true},
    {"id": "aginor_surge_01", "speaker": "AGINOR", "who": "aginor", "text": "The Eye... so much... more!", "file": "assets/audio/voice/aginor_surge_01.mp3", "engine": "elevenlabs"},
    {"id": "aginor_burn_01", "speaker": "AGINOR", "who": "aginor", "text": "(scream)", "file": "assets/audio/voice/aginor_burn_01.mp3", "engine": "elevenlabs"},
    {"id": "balthamel_laugh_01", "speaker": "BALTHAMEL", "who": "balthamel", "text": "(dry laugh)", "file": "assets/audio/voice/balthamel_laugh_01.mp3", "engine": "elevenlabs"},
    {"id": "greenman_arrive_01", "speaker": "GREEN MAN", "who": "greenman", "text": "You will not touch my garden.", "file": "assets/audio/voice/greenman_arrive_01.mp3", "engine": "elevenlabs"},
    {"id": "greenman_fall_01", "speaker": "GREEN MAN", "who": "greenman", "text": "Grow... again...", "file": "assets/audio/voice/greenman_fall_01.mp3", "engine": "elevenlabs"}
