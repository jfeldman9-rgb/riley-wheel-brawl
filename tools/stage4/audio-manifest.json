    {"id": "st4_story_04", "speaker": "MORDETH", "who": "mordeth", "text": "Stay... and be welcome... forever.", "file": "assets/audio/voice/st4_story_04.mp3", "engine": "elevenlabs"},
    {"id": "st4_story_05", "speaker": "NARRATOR", "who": "narrator", "text": "Riley walked in.", "file": "assets/audio/voice/st4_story_05.mp3", "engine": "elevenlabs"},
    {"id": "st4_clear_01", "speaker": "RILEY", "who": "riley", "text": "The trail goes underground. A Waygate.", "file": "assets/audio/voice/st4_clear_01.mp3", "engine": "kokoro"},
    {"id": "st4_clear_02", "speaker": "LOIAL", "who": "loial", "text": "Riley, the Ways are dark. Nobody goes into the Ways.", "file": "assets/audio/voice/st4_clear_02.mp3", "engine": "kokoro"},
    {"id": "st4_clear_03", "speaker": "RILEY", "who": "riley", "text": "Then show me how.", "file": "assets/audio/voice/st4_clear_03.mp3", "engine": "kokoro"}
