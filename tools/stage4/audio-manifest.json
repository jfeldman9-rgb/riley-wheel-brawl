    {"id": "st4_story_01", "speaker": "NARRATOR", "who": "narrator", "text": "The Fade fled Caemlyn by night. Its trail ran east, to a city no map still names.", "file": "assets/audio/voice/st4_story_01.mp3", "engine": "elevenlabs"},
